    "type": "base",
    "field": "overdue_amt",
    "agg": "sum",
    "unit": "元",
    "precision": 0,
    "enabled": true,
    "groupBy": [
      "product"
    ],
    "vizType": "line",
    "vizSampleId": "vs_monthly_overdue"
  },
  {
    "id": "m_credit_line",
