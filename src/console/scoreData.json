      "algoType": "加权融合（Fusion · 多模型集成）",
      "algoCode": "# 智融分 · 综合价值模型（加权融合）\n# 融合 违约(智信分) + 兴趣 + 转化意愿 + 资产\ndef score_zhirong(cust):\n    return (\n        0.34 * normalize(zhixin(cust)) +\n        0.24 * interest(cust) +\n        0.18 * conversion(cust) +\n        0.24 * asset(cust)\n    ) * 600 + 300                       # 映射至 300-900\n\n# 融合权重\nWEIGHTS = {\n    '违约维度（智信分）': 0.34,\n    '借贷兴趣':           0.24,\n    '转化意愿':           0.18,\n    '资产状况':           0.24,\n}",
