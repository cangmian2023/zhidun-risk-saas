<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>机构列表</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
    background: #F5F6F8;
    color: #1D2129;
    font-size: 14px;
    -webkit-font-smoothing: antialiased;
  }

  /* 顶部导航 */
  .top-nav {
    display: flex;
    align-items: center;
    padding: 0 24px;
    height: 56px;
    background: #FFFFFF;
    border-bottom: 1px solid #E5E6EB;
  }
  .top-nav .nav-tabs { display: flex; align-items: center; }
  .top-nav .nav-tab {
    padding: 0 22px; height: 56px;
    display: flex; align-items: center;
    font-size: 17px; color: #4E5969;
    cursor: pointer; position: relative;
    white-space: nowrap; user-select: none;
  }
  .top-nav .nav-tab.active { color: #1D2129; font-weight: 600; }
  .top-nav .nav-tab.active::after {
    content: ""; position: absolute; bottom: 0; left: 50%;
    transform: translateX(-50%); width: 36px; height: 3px;
    background: #F7BA1E; border-radius: 2px;
  }
  .top-nav .search-box {
    margin-left: auto; display: flex; align-items: center;
    width: 340px; height: 38px; border: 1px solid #C9CDD4;
    border-radius: 4px; padding: 0 14px; background: #FFFFFF;
  }
  .top-nav .search-box svg {
    width: 17px; height: 17px; margin-right: 10px;
    flex-shrink: 0; color: #86909C;
  }
  .top-nav .search-box input {
    flex: 1; border: none; outline: none; font-size: 15px;
    color: #86909C; background: transparent; font-family: inherit;
  }

  /* 筛选区域 */
  .filter-section {
    background: #FFFFFF; padding: 18px 24px 14px;
    border-bottom: 1px solid #E5E6EB;
  }
  .filter-row {
    display: flex; align-items: flex-start; margin-bottom: 14px;
  }
  .filter-row:last-child { margin-bottom: 0; }
  .filter-row .filter-label {
    width: 76px; flex-shrink: 0; font-size: 16px;
    color: #1D2129; font-weight: 600; padding-top: 7px;
  }
  .filter-row .filter-options {
    display: flex; flex-wrap: wrap; align-items: center;
    gap: 2px; flex: 1;
  }
  .filter-row .filter-option {
    padding: 7px 14px; font-size: 16px; color: #4E5969;
    border-radius: 4px; cursor: pointer; white-space: nowrap;
    transition: all .15s; user-select: none;
  }
  .filter-row .filter-option:hover { color: #165DFF; }
  .filter-row .filter-option.active {
    background: #E8F3FF; color: #165DFF; font-weight: 500;
  }
  .filter-row .filter-collapse {
    display: inline-flex; align-items: center; padding: 7px 14px;
    font-size: 16px; color: #165DFF; cursor: pointer;
    white-space: nowrap; margin-left: auto; user-select: none; flex-shrink: 0;
  }
  .filter-row .filter-collapse::after {
    content: ""; display: inline-block; width: 0; height: 0;
    margin-left: 6px;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-bottom: 5px solid #165DFF;
  }

  /* 卡片网格 */
  .card-grid {
    display: grid; grid-template-columns: repeat(3, 1fr);
    gap: 12px; padding: 14px 24px 28px; background: #F5F6F8;
  }
  .card {
    background: #FFFFFF; border-radius: 6px; padding: 20px;
    display: flex; align-items: center; gap: 14px;
    cursor: pointer; transition: box-shadow .2s, border-color .2s;
    border: 1px solid transparent; min-height: 80px;
  }
  .card:hover {
    box-shadow: 0 4px 14px rgba(0,0,0,0.07); border-color: #E5E6EB;
  }
  .card .dept-tag {
    flex-shrink: 0;
    width: 56px; height: 56px;
    background: #E8F3FF;
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    font-size: 16px;
    font-weight: 600;
    color: #165DFF;
    line-height: 1.25;
    padding: 4px;
  }
  .card .dept-name {
    flex: 1; min-width: 0;
    font-size: 18px; font-weight: 600; color: #1D2129;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
</style>
</head>
<body>

<!-- 顶部导航 -->
<div class="top-nav">
  <div class="nav-tabs">
    <div class="nav-tab">关注</div>
    <div class="nav-tab">央企</div>
    <div class="nav-tab">国企</div>
    <div class="nav-tab">民营</div>
    <div class="nav-tab">外资</div>
    <div class="nav-tab active">机构</div>
  </div>
  <div class="search-box">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
    <input type="text" placeholder="输入企业或集团关键字">
  </div>
</div>

<!-- 筛选区域 -->
<div class="filter-section">
  <div class="filter-row">
    <div class="filter-label">选择省份</div>
    <div class="filter-options">
      <span class="filter-option active">北京市</span>
      <span class="filter-option">天津市</span>
      <span class="filter-option">河北省</span>
      <span class="filter-option">山西省</span>
      <span class="filter-option">内蒙古自治区</span>
      <span class="filter-option">辽宁省</span>
      <span class="filter-option">吉林省</span>
      <span class="filter-option">黑龙江省</span>
      <span class="filter-option">上海市</span>
      <span class="filter-option">江苏省</span>
      <span class="filter-option">浙江省</span>
      <span class="filter-option">安徽省</span>
      <span class="filter-option">福建省</span>
      <span class="filter-option">江西省</span>
      <span class="filter-option">山东省</span>
      <span class="filter-option">河南省</span>
      <span class="filter-option">湖北省</span>
      <span class="filter-option">湖南省</span>
      <span class="filter-option">广东省</span>
      <span class="filter-option">广西壮族自治区</span>
      <span class="filter-option">海南省</span>
      <span class="filter-option">重庆市</span>
      <span class="filter-option">四川省</span>
      <span class="filter-option">贵州省</span>
      <span class="filter-option">云南省</span>
      <span class="filter-option">西藏自治区</span>
      <span class="filter-option">陕西省</span>
      <span class="filter-option">甘肃省</span>
      <span class="filter-option">青海省</span>
      <span class="filter-option">宁夏回族自治区</span>
      <span class="filter-option">新疆维吾尔自治区</span>
      <span class="filter-collapse">收起</span>
    </div>
  </div>
  <div class="filter-row">
    <div class="filter-label">选择城市</div>
    <div class="filter-options">
      <span class="filter-option active">直辖市</span>
    </div>
  </div>
</div>

<!-- 卡片网格 -->
<div class="card-grid">

  <!-- 1. 北京发改委 -->
  <div class="card">
    <div class="dept-tag">发改<br>委</div>
    <div class="dept-name">北京发改委</div>
  </div>

  <!-- 2. 北京经济和信息化局 -->
  <div class="card">
    <div class="dept-tag">经济<br>和信</div>
    <div class="dept-name">北京经济和信息化局</div>
  </div>

  <!-- 3. 北京科学技术局 -->
  <div class="card">
    <div class="dept-tag">科学<br>技术</div>
    <div class="dept-name">北京科学技术局</div>
  </div>

  <!-- 4. 北京公安局 -->
  <div class="card">
    <div class="dept-tag">公安<br>局</div>
    <div class="dept-name">北京公安局</div>
  </div>

  <!-- 5. 北京民政局 -->
  <div class="card">
    <div class="dept-tag">民政<br>局</div>
    <div class="dept-name">北京民政局</div>
  </div>

  <!-- 6. 北京司法局 -->
  <div class="card">
    <div class="dept-tag">司法<br>局</div>
    <div class="dept-name">北京司法局</div>
  </div>

  <!-- 7. 北京财政局 -->
  <div class="card">
    <div class="dept-tag">财政<br>局</div>
    <div class="dept-name">北京财政局</div>
  </div>

  <!-- 8. 北京人社局 -->
  <div class="card">
    <div class="dept-tag">人社<br>局</div>
    <div class="dept-name">北京人社局</div>
  </div>

  <!-- 9. 北京规划和自然资源局 -->
  <div class="card">
    <div class="dept-tag">规划<br>和自</div>
    <div class="dept-name">北京规划和自然资源局</div>
  </div>

  <!-- 10. 北京生态环境局 -->
  <div class="card">
    <div class="dept-tag">生态<br>环境</div>
    <div class="dept-name">北京生态环境局</div>
  </div>

  <!-- 11. 北京城乡建设委员会 -->
  <div class="card">
    <div class="dept-tag">城乡<br>建设</div>
    <div class="dept-name">北京城乡建设委员会</div>
  </div>

  <!-- 12. 北京住房保障和房产管理局 -->
  <div class="card">
    <div class="dept-tag">住房<br>保障</div>
    <div class="dept-name">北京住房保障和房产管理局</div>
  </div>

  <!-- 13. 北京园林文物局 -->
  <div class="card">
    <div class="dept-tag">园林<br>文物</div>
    <div class="dept-name">北京园林文物局</div>
  </div>

  <!-- 14. 北京交通运输局 -->
  <div class="card">
    <div class="dept-tag">交通<br>运输</div>
    <div class="dept-name">北京交通运输局</div>
  </div>

  <!-- 15. 北京林业水利局 -->
  <div class="card">
    <div class="dept-tag">林业<br>水利</div>
    <div class="dept-name">北京林业水利局</div>
  </div>

</div>

</body>
</html>
